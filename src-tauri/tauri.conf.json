{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ClaudeMeowPet",
  "version": "2.0.0",
  "identifier": "com.claudemeow.pet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClaudeMeowPet",
        "url": "index.html",
        "width": 420,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "x": 100,
        "y": 100
      },
      {
        "label": "settings",
        "title": "ClaudeMeowPet - Settings",
        "url": "settings.html",
        "width": 560,
        "height": 720,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ]
  }
}

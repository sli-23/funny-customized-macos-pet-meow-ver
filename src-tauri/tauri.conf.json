{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ClaudeMeow",
  "version": "1.2.2",
  "identifier": "com.claudemeow.pet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClaudeMeow",
        "url": "index.html",
        "width": 420,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "x": 100,
        "y": 100
      },
      {
        "label": "settings",
        "title": "ClaudeMeow - Settings",
        "url": "settings.html",
        "width": 640,
        "height": 780,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true
      },
      {
        "label": "status",
        "title": "Meow Status",
        "url": "status.html",
        "width": 360,
        "height": 430,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ]
  }
}

{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ClaudeMeow",
  "version": "1.3.2",
  "identifier": "com.claudemeow.pet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClaudeMeow",
        "url": "index.html",
        "width": 450,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "x": 100,
        "y": 100
      },
      {
        "label": "settings",
        "title": "",
        "url": "settings.html",
        "width": 640,
        "height": 780,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "status",
        "title": "",
        "url": "status.html",
        "width": 360,
        "height": 430,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "dev",
        "title": "",
        "url": "dev.html",
        "width": 500,
        "height": 150,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "x": 100,
        "y": 5
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QTVGMTcxMEE3NDk0RjUKUldUMWxIUUtjZkdsR1Ird2NmdWRSMnROb2p3OTJhTFB2QkNOM283Q1c4Mm1icGJuZitDSmdqa1AK",
      "endpoints": [
        "https://github.com/sli-23/funny-customized-macos-pet-meow-ver/releases/latest/download/latest.json"
      ]
    }
  }
}
